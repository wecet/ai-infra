# Copy to .env and replace every value marked "change-me" before exposing the stack.
COMPOSE_PROJECT_NAME=ai-infra
NETWORK_NAME=ai-infra-network

LABELLING_IMAGE=ai-infra/labelling:local
LAKEFS_IMAGE=treeverse/lakefs:latest
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:latest
TRAINING_AGENT_IMAGE=ai-infra/training-agent:local

# Host ports. 8081 is used because 8080 was occupied on the development host.
LABELLING_PORT=8081
LAKEFS_PORT=8002
MLFLOW_PORT=5001
TRAINING_AGENT_PORT=8090
TENSORBOARD_PORT=6006
# Optional URL reachable by the browser (set this for remote hosts/reverse proxies).
# TENSORBOARD_PUBLIC_URL=http://192.168.1.20:6006
TRAINING_RUNS_VOLUME=ai-infra_training_runs
TRAINING_GPU_AVAILABLE=auto
# Read-only host directory recursively searched for explicit ai-workbench.json files.
TRAINING_WORKSPACES_PATH=/absolute/path/to/Documents

LABELLING_VOLUME=ai-infra_labelling_data
LAKEFS_VOLUME=ai-infra_lakefs_data
MLFLOW_VOLUME=ai-infra_mlflow_data
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Keep these lakeFS values stable after first startup.
LAKEFS_USER_NAME=admin
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=change-me-use-a-long-random-value
LAKEFS_ACCESS_KEY_ID=change-me-lakefs-access-key
LAKEFS_SECRET_ACCESS_KEY=change-me-lakefs-secret-key
LAKEFS_REPOSITORY=datasets
LAKEFS_BRANCH=main
LAKEFS_STORAGE_NAMESPACE=local://datasets

# Optional AI-assisted labelling. Leave OPENAI_API_KEY empty for manual labelling.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_IMAGE_DETAIL=high
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
OPENAI_REASONING_EFFORT=

# MySQL-backed Studio identities and repository access. Set unique random passwords.
AUTH_MYSQL_DATABASE=studio_auth
AUTH_MYSQL_USER=studio
AUTH_MYSQL_PASSWORD=
AUTH_MYSQL_ROOT_PASSWORD=
AUTH_MYSQL_VOLUME=ai-infra_auth_mysql
# Use true behind HTTPS; false permits local HTTP development.
AUTH_COOKIE_SECURE=false
