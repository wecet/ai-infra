{
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [
      150
    ],
  },
  "black-formatter.args": [
    "--line-length=150",
  ],
  "flake8.args": [
    "--ignore=E501,W503",
    "--max-line-length=150" 
  ],
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.configureArgs": [
    "-DOVERWRITE_PYTHON_EXECUTABLE_PATH=${workspaceFolder}/.venv/bin/python3",
  ],
  "python.testing.pytestArgs": [
    "test",
    "-vv",
    "-ss",
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
}