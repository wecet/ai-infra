# Plaintext development values. Replace credentials before remote use.
HOST_APP=<default>

DEPLOYED_CONFIG_PATH=/tmp/ai-infra-deployment/dev
DISABLED_SERVICES=""

NETWORK_NAME=ai-infra-network
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:latest
LAKEFS_IMAGE=treeverse/lakefs:latest
LABELLING_IMAGE=ai-infra/labelling:dev

MLFLOW_PORT=5001
LAKEFS_PORT=8002
LABELLING_PORT=8080

LAKEFS_VOLUME=ai-infra_lakefs_data
LABELLING_VOLUME=ai-infra_labelling_data
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
