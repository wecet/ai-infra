# Plaintext development values. Replace credentials before remote use.
HOST_APP=<default>
DEPLOYED_CONFIG_PATH=/tmp/ai-infra-deployment/dev
DISABLED_SERVICES=""
NETWORK_NAME=ai-infra-network
POSTGRES_IMAGE=postgres:16
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:latest
LAKEFS_IMAGE=treeverse/lakefs:latest
LABELLING_IMAGE=ai-infra/labelling:dev
POSTGRES_USER=mlops
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=mlops
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=local-development-only-change-me
MLFLOW_PORT=5001
LAKEFS_PORT=8002
LABELLING_PORT=8080
# Match the original Compose project volume names to preserve existing data.
POSTGRES_VOLUME=ai-infra_postgres_data
LAKEFS_VOLUME=ai-infra_lakefs_data
LABELLING_VOLUME=ai-infra_labelling_data
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
