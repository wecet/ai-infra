# Plaintext development values. Replace credentials before remote use.
HOST_DMZ="ssh://openiiot_local_ai"
HOST_APP="ssh://openiiot_local_ai"
HOST_DATA="ssh://openiiot_local_ai"
HOST_TOOL="ssh://openiiot_local_ai"

DEPLOYED_CONFIG_PATH=/services/config/ai-infra/local
DISABLED_SERVICES=""
NETWORK_NAME=ai-infra-network

POSTGRES_IMAGE=postgres:16
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:latest
LAKEFS_IMAGE=treeverse/lakefs:latest
LABELLING_IMAGE=registry.example.com/ai-infra/labelling:v1.0.0

POSTGRES_USER=mlops
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=mlops
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=local-development-only-change-me

MLFLOW_PORT=5001
LAKEFS_PORT=8002
LABELLING_PORT=8080

# Match the legacy stack's volume names to preserve existing data.
POSTGRES_VOLUME=ai-infra_postgres_data
LAKEFS_VOLUME=ai-infra_lakefs_data
LABELLING_VOLUME=ai-infra_labelling_data
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
